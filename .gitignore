# ══════════════════════════════════════════════════════
#  SmartSolar Microgrid — Root .gitignore
# ══════════════════════════════════════════════════════

# ── .NET / C# ─────────────────────────────────────────
bin/
obj/
*.dll
*.exe
*.pdb
*.cache
*.user
*.suo
*.ntvs*
*.njsproj

# NuGet
*.nupkg
.nuget/
packages/

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
build/
bld/

# Visual Studio
.vs/
*.rsuser
*.sln.docstates
launchSettings.json

# Rider / JetBrains
.idea/
*.sln.iml

# ── Node.js / React / Vite ───────────────────────────
node_modules/
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── OS Files ──────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.sw?

# ── Editor ────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ── Misc ──────────────────────────────────────────────
*.env
*.env.local
*.env.*.local

# Java error logs (from the repo root)
hs_err_pid*.log
replay_pid*.log
