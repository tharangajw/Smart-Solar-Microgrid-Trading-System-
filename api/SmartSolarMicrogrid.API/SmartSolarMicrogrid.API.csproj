<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Target .NET 10 – compatible with installed runtime 10.0.11 -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- OpenAPI/Swagger – Swashbuckle 6.x requires Microsoft.OpenApi 1.x -->
    <!-- Do NOT add Microsoft.AspNetCore.OpenApi 9/10 – it pulls in OpenApi 2.x which breaks Swashbuckle -->
    <PackageReference Include="Microsoft.OpenApi" Version="1.6.22" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.8.0" />

    <!-- MongoDB driver – single version, latest stable for net8 -->
    <PackageReference Include="MongoDB.Driver" Version="2.28.0" />

    <!-- BCrypt password hashing -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />

    <!-- JWT authentication -->
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.0.2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
  </ItemGroup>

</Project>
