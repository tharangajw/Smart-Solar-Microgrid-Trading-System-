<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/colorPrimary"
        android:padding="16dp"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/buttonBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="@color/white" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update Reservation"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_margin="16dp"
        android:background="@android:color/white"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Grid Node (Locked)"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:id="@+id/textNodeId"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input_outlined"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:layout_marginBottom="16dp"
            android:enabled="false"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select New Slot"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>
            
        <TextView
            android:id="@+id/textSlotPicker"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input_outlined"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:text="Loading slots..."
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/buttonUpdate"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Save Changes"
            android:backgroundTint="@color/colorPrimary"
            android:textColor="@android:color/white"/>

        <ProgressBar
            android:id="@+id/progressUpdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone"/>

    </LinearLayout>
</LinearLayout>
