<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartSolarMicrogrid"
        tools:targetApi="31">

        <activity
            android:name=".modules.splash.SplashActivity"
            android:theme="@style/Theme.SmartSolarMicrogrid.Onboarding"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".modules.onboarding.OnboardingActivity"
            android:theme="@style/Theme.SmartSolarMicrogrid.Onboarding"
            android:exported="false" />

        <!-- Authentication -->
        <activity android:name=".modules.authentication.LoginActivity" android:exported="false" />
        <activity android:name=".modules.authentication.RegisterActivity" android:exported="false" />
        <activity android:name=".modules.authentication.ProfileActivity" android:exported="false" />

        <!-- Prosumer -->
        <activity android:name=".modules.prosumer.ProsumerDashboardActivity" android:exported="false" />

        <!-- Map & Reservations -->
        <activity android:name=".modules.map.StationMapActivity" android:exported="false" />
        <activity android:name=".modules.reservations.CreateReservationActivity" android:exported="false" />
        <activity android:name=".modules.history.EnergyHistoryActivity" android:exported="false" />

        <!-- QR -->
        <activity android:name=".modules.qr.QRDisplayActivity" android:exported="false" />
        <activity android:name=".modules.qr.QRScannerActivity" android:exported="false" />

        <!-- Operator -->
        <activity android:name=".modules.operator.OperatorDashboardActivity" android:exported="false" />

    </application>

</manifest>