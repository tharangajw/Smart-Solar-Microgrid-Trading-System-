# Smart Solar Microgrid — Web App Environment Variables Example
# Copy this file to .env and fill in real values.
# Do NOT commit .env to version control (it is in .gitignore).

# Google Maps JavaScript API key (enable Maps JS API in Google Cloud Console)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Base URL for the Smart Solar Microgrid Web API
VITE_API_BASE_URL=http://localhost:5281/api
